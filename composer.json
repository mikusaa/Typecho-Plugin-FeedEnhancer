{
    "name": "typecho-plugin/feed-enhancer",
    "description": "Privacy-hardened protocol enhancements for Typecho feeds.",
    "type": "typecho-plugin",
    "license": "MIT",
    "require": {
        "php": ">=7.4",
        "ext-dom": "*",
        "ext-libxml": "*"
    },
    "require-dev": {
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "phpcompatibility/php-compatibility": "^9.3",
        "phpunit/phpunit": "^9.6",
        "squizlabs/php_codesniffer": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "TypechoPlugin\\FeedEnhancer\\": ""
        }
    },
    "autoload-dev": {
        "psr-4": {
            "TypechoPlugin\\FeedEnhancer\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --configuration phpunit.xml.dist",
        "lint": "phpcs --standard=phpcs.xml.dist",
        "cs": "@lint"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "platform": {
            "php": "7.4.0"
        },
        "sort-packages": true
    }
}
